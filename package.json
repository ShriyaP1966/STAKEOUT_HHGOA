{
  "name": "stakeout",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint \"contracts/**/*.sol\"",
    "typecheck": "tsc --noEmit",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "node:local": "hardhat node",
    "deploy:local": "hardhat run --network localhost scripts/deploy.ts",
    "deploy:target": "hardhat run --network target scripts/deploy.ts",
    "safe:calldata": "ts-node --transpile-only scripts/safe-calldata.ts",
    "seed:local": "hardhat run --network localhost scripts/seed-local.ts",
    "fund:local": "ts-node --transpile-only scripts/fund-local.ts",
    "gen:deployer": "ts-node --transpile-only scripts/gen-deployer.ts",
    "check:env": "ts-node --transpile-only scripts/check-env.ts",
    "create:safe": "ts-node --transpile-only scripts/create-safe.ts",
    "deploy:check": "ts-node --transpile-only scripts/deploy-check.ts",
    "check:deployment": "ts-node --transpile-only scripts/check-deployment.ts",
    "verify:target": "hardhat run --network target scripts/verify-target.ts",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web run test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "solhint": "6.2.5",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/protocol-kit": "8.0.7",
    "dotenv": "18.0.9",
    "zod": "4.6.7"
  }
}
